---
import '../styles.css';
import ActivitySlider from '../components/ActivitySlider.astro';
import profile from '../data/profile.json';
import { Content as Biography } from '../content/biography.md';
import { Content as Interests } from '../content/interests.md';
const entries = Object.entries(import.meta.glob('../content/sections/*.md', { eager: true })).map(([path, mod]:[string, any]) => ({id:path.split('/').pop()!.replace('.md',''), ...mod.frontmatter, Content:mod.Content})).sort((a,b)=>a.order-b.order);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Tousif Hasan Lavlu — machine learning researcher, educator and MEng student at RheinMain University of Applied Sciences and Arts."/><title>Tousif Hasan Lavlu | Research & Projects</title><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('theme')||'light'}catch{}</script></head>
<body><a class="skip" href="#main">Skip to content</a><header><a class="header-name" href="#about">Tousif Hasan Lavlu</a><div class="controls"><button id="menu" aria-label="Open navigation" aria-controls="site-navigation" aria-expanded="false"><span class="menu-glyph" aria-hidden="true">☰</span></button><button id="theme" aria-label="Switch to dark mode">◐</button></div><nav id="site-navigation" aria-label="Main navigation"><a href="#about" class="active">About</a>{entries.map(s=><a href={`#${s.id}`}>{s.title}</a>)}</nav></header>
<main id="main"><section id="about" class="hero"><div class="hero-grid"><aside class="profile-card" aria-label="Profile and social links"><img class="profile-photo" src="/profile.jpg" alt="Portrait of Tousif Hasan Lavlu" width="1141" height="1379" fetchpriority="high"/><div class="profile-links" aria-label="Contact and academic profiles"><a href={profile.email} aria-label="Email Tousif" title="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg><span>Email</span></a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile" title="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5.4 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM3.7 8.5h3.4V21H3.7zM9.5 8.5h3.3v1.7c.7-1.2 1.8-2 3.6-2 3.2 0 4 2.1 4 5V21H17v-6.9c0-1.7-.3-2.8-1.9-2.8-1.8 0-2.2 1.4-2.2 3V21H9.5z"/></svg><span>LinkedIn</span></a><a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub profile" title="GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.6 9.6 0 0 1 12 6.82c.85 0 1.71.12 2.51.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg><span>Git</span></a>{profile.scholar ? <a href={profile.scholar} target="_blank" rel="noopener noreferrer" aria-label="Google Scholar profile"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 12 8-12 8L0 10z"/><circle cx="12" cy="17" r="5"/></svg><span>Scholar</span></a> : <span class="profile-link-pending" role="link" aria-disabled="true" aria-label="Google Scholar — profile URL needed" title="Google Scholar profile URL needed"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 12 8-12 8L0 10z"/><circle cx="12" cy="17" r="5"/></svg><span>Scholar</span></span>}<a class="cv-icon" href="/CV_Tousif.pdf" download="CV_Tousif.pdf" aria-label="Download CV" title="Download CV"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 2h8l4 4v16H6zM14 2v5h4"/><path d="M9 11h6M9 14h6M9 17h4"/></svg><span>CV</span></a></div><p class="profile-caption">AI researcher &amp; educator · Germany</p></aside><div class="hero-introduction"><h1 class="about-heading">About</h1><div class="biography"><Biography /></div><div class="research-interests"><h2>Research interests</h2><Interests /></div></div></div></section>
{entries.map((s)=><section id={s.id} class={`content-section section-${s.id}`}><div class="section-heading"><div><h2>{s.title}</h2><p>{s.subtitle}</p></div><a class="back-top" href="#about" aria-label="Back to top">↗</a></div><div class="markdown"><s.Content/>{s.id==='achievements'&&<ActivitySlider/>}</div></section>)}
</main><footer><p>© {new Date().getFullYear()} Tousif Hasan Lavlu</p><a href="#about">Back to top ↑</a></footer>
<script>
const toggle=document.querySelector<HTMLButtonElement>('#theme')!;function sync(){const dark=document.documentElement.dataset.theme==='dark';toggle.setAttribute('aria-label',dark?'Switch to light mode':'Switch to dark mode');toggle.textContent=dark?'☼':'◐';}sync();toggle.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=next;try{localStorage.setItem('theme',next)}catch{}sync()});
const menu=document.querySelector<HTMLButtonElement>('#menu')!;const nav=document.querySelector('nav')!;
function setMenu(open:boolean){menu.setAttribute('aria-expanded',String(open));menu.setAttribute('aria-label',open?'Close navigation':'Open navigation');nav.classList.toggle('open',open);menu.querySelector('.menu-glyph')!.textContent=open?'×':'☰';}
menu.addEventListener('click',()=>setMenu(menu.getAttribute('aria-expanded')!=='true'));
nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>setMenu(false)));
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&menu.getAttribute('aria-expanded')==='true'){setMenu(false);menu.focus()}});
document.addEventListener('click',e=>{if(!(e.target as Element).closest('header'))setMenu(false)});
window.matchMedia('(min-width: 1001px)').addEventListener('change',()=>setMenu(false));
const observer=new IntersectionObserver(items=>{items.forEach(item=>{if(item.isIntersecting){nav.querySelectorAll('a').forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+item.target.id))}})},{rootMargin:'-15% 0px -65% 0px',threshold:0});document.querySelectorAll('main section').forEach(s=>observer.observe(s));
</script></body></html>
